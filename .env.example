# Copy this file to .env.local and paste your keys there. .env.local is gitignored.
# The keys are only used by the dev server (pnpm dev); production builds leave them out,
# so the deployed site still asks each visitor for their own key.
VITE_ANTHROPIC_API_KEY=
# Optional: lets the photo coach use OpenAI instead of Claude.
VITE_OPENAI_API_KEY=
# Optional: a free Pexels key (pexels.com/api) lets the photo coach find real reference clips.
VITE_PEXELS_API_KEY=
